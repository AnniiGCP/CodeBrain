VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# SECURITY NOTE:
# Never add AI provider keys (Groq, NVIDIA, Anthropic, OpenAI) or GitHub secrets here.
# All provider credentials remain exclusively protected on the FastAPI backend.
